# Optional unattended/server deployment overrides. Interactive installations
# use the initializer and store this configuration in .voiceish/config.json.
DATABASE_URL=postgres://voiceish:change-me@127.0.0.1:5432/voiceish
VOICEISH_HOST=127.0.0.1
VOICEISH_PORT=8790
VOICEISH_PUBLIC_URL=http://127.0.0.1:8790
VOICEISH_ALLOWED_ORIGINS=http://127.0.0.1:8787
VOICEISH_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
VOIPMS_API_USERNAME=reseller@example.com
VOIPMS_API_PASSWORD=replace-with-api-password
VOIPMS_API_URL=https://voip.ms/api/v1/rest.php
